// Madrasa Student Progress — database schema
// Three models only: User, Student, DailyRecord.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

/// Every person who can sign in (admins, teachers, students).
model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  username     String   @unique @db.VarChar(50)
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Set when role = STUDENT: the student's profile.
  studentProfile   Student?      @relation("StudentAccount")
  /// Set when role = TEACHER: students assigned to this teacher.
  assignedStudents Student[]     @relation("TeacherStudents")
  /// Set when role = TEACHER: records this teacher marked.
  markedRecords    DailyRecord[] @relation("RecordTeacher")

  @@index([role])
}

/// Student profile, linked 1:1 to a STUDENT user account.
model Student {
  id        String   @id @default(cuid())
  userId    String   @unique
  className String   @db.VarChar(50)
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation("StudentAccount", fields: [userId], references: [id], onDelete: Cascade)
  teacher User?         @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: SetNull)
  records DailyRecord[]

  @@index([teacherId])
  @@index([className])
}

/// One record per student per date.
/// The teacher writes the day's tasks; the student ticks what they did.
/// Every tick stores the moment it was made (`…At`) so the teacher can check it.
model DailyRecord {
  id        String   @id @default(cuid())
  studentId String
  /// The student's teacher for this record. Kept nullable in the DB only so a
  /// student's history survives if that teacher account is later deleted.
  teacherId String?
  date      DateTime @db.Date

  // Prayers (ticked by the student)
  fajr      Boolean   @default(false)
  fajrAt    DateTime?
  dhuhr     Boolean   @default(false)
  dhuhrAt   DateTime?
  asr       Boolean   @default(false)
  asrAt     DateTime?
  maghrib   Boolean   @default(false)
  maghribAt DateTime?
  isha      Boolean   @default(false)
  ishaAt    DateTime?

  // Daily activities (ticked by the student)
  homework       Boolean   @default(false)
  homeworkAt     DateTime?
  unitReading    Boolean   @default(false)
  unitReadingAt  DateTime?
  quranReading   Boolean   @default(false)
  quranReadingAt DateTime?
  writing        Boolean   @default(false)
  writingAt      DateTime?
  dikrByheart    Boolean   @default(false)
  dikrByheartAt  DateTime?
  quranHifz      Boolean   @default(false)
  quranHifzAt    DateTime?

  // Task details written by the teacher (optional, e.g. "Surah Al-Mulk 1–10")
  homeworkTask     String? @db.VarChar(300)
  unitReadingTask  String? @db.VarChar(300)
  quranReadingTask String? @db.VarChar(300)
  writingTask      String? @db.VarChar(300)
  dikrByheartTask  String? @db.VarChar(300)
  quranHifzTask    String? @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?   @relation("RecordTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([date])
  @@index([teacherId])
}
