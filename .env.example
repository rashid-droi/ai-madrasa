# ── Database ────────────────────────────────────────────────
# Used by the app at runtime. On Vercel, use your provider's POOLED URL
# (Neon "-pooler" host, Supabase transaction pooler on port 6543, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional. Used only by Prisma CLI for migrations and seeding.
# Set it to the DIRECT (non-pooled) URL when DATABASE_URL is pooled.
DIRECT_URL=""

# ── Sessions ────────────────────────────────────────────────
# Secret used to sign session cookies. At least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=""

# ── First admin (used by `npm run db:seed` only) ────────────
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
